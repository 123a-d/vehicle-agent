# Copy this file to .env only if your own launcher loads dotenv files.
# The current application reads these values directly from the process environment.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
VEHICLE_DATABASE_PATH=./database/vehicle_agent.db
VEHICLE_CHECKPOINT_PATH=./outputs/unknown_weighted/best_macro_f1.pth
VEHICLE_UPLOAD_ROOT=./uploads
VEHICLE_WEB_INDEX_PATH=./web/index.html
VEHICLE_MAX_IMAGE_BYTES=10485760
VEHICLE_LOG_LEVEL=INFO
VEHICLE_DATA_ROOT=./data/raw
